  {
    "id": "weaver-ecology-wui-exposure",
    "info": {
      "name": "泛微 e-cology 前端入口暴露",
      "severity": "low",
      "description": "泛微 e-cology 的 /wui/index.html 未授权可访问（该页通常只以 JSESSIONID 下发会话、页面本身需登录），可用于确认资产身份与版本线索。只读探测，不涉及任何接口调用。",
      "tags": ["exposure", "cn-app", "oa", "weaver"],
      "confidence": "medium"
    },
    "http": [
      {
        "method": "GET",
        "path": ["{{BaseURL}}/wui/index.html"],
        "matchers-condition": "and",
        "matchers": [
          { "type": "status", "status": [200] },
          { "type": "header", "headers": { "Set-Cookie": "(?i)JSESSIONID=" }, "condition": "and" },
          { "type": "word", "part": "body", "words": ["/wui/theme/", "/wui/common/"], "condition": "or" }
        ],
        "extractors": [
          { "type": "kval", "kval": ["Set-Cookie"], "name": "session_cookie" }
        ]
      }
    ]
  },
